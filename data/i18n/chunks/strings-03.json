 "items": [
  {
   "i": 656,
   "ko": "managed settings가 없고 Team·Enterprise 플랜으로 로그인하지 않은 개인 사용자",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 657,
   "ko": "mod가 한 번 로드되면 이런 걸 할 수 있어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 658,
   "ko": "mod는 샌드박스 없이 내 권한으로 Claude Code 안에서 돌아요. 그래서 설치하기 전에 뭘 할 수 있는지 알아 두는 게 중요해요. 이 글은 mod가 닿을 수 있는 범위, 설치 전 직접 확인하는 법, k-mods가 검토하는 기준과 권한 라벨, 조직 관리자가 쓸 수 있는 통제, 조심해야 할 신호를 정리해요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 659,
   "ko": "mod는 샌드박스가 없어요",
   "ctx": "/guide/safety",
   "n": 2
  },
  {
   "i": 660,
   "ko": "mod를 안전하게 쓰는 법 · Claude Code mods 가이드 · k-mods",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 661,
   "ko": "“화면만 바꾼다”는 설명인데 🌐 네트워크나 ⚙️ 프로그램 실행 라벨이 붙어 있어요. 설명과 권한이 안 맞으면 코드를 더 읽어 보는 게 좋아요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 662,
   "ko": "⚙️ 프로그램 실행",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 663,
   "ko": "✏️ 파일 쓰기",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 664,
   "ko": "가 있는데, 대화 내용을 기기 밖으로 보내지 않는다는 설명이 없어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 665,
   "ko": "각 mod 페이지(또는",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 666,
   "ko": "각 mod 페이지에는 정적 분석으로 찾아낸 권한이 라벨로 붙어요. 위험한 것부터 나열했어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 667,
   "ko": "검토 기록",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 668,
   "ko": "계열로 파일을 읽어요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 669,
   "ko": "권한 라벨",
   "ctx": "/guide/safety",
   "n": 4
  },
  {
   "i": 670,
   "ko": "권한 라벨 표시",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 671,
   "ko": "권한 확인 대화상자 자체는 못 바꿔요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 672,
   "ko": "규칙으로 막아 둔 호출까지 mod가 뒤집어 승인할 수 있어요. 다만 mod는 Claude Code의",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 673,
   "ko": "규칙이 물어볼 호출이나, 내",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 674,
   "ko": "내 계정이 닿는 어디든 파일을 읽거나 써요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 675,
   "ko": "내 권한으로 프로그램을 실행해요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 676,
   "ko": "내 비밀 정보 읽기",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 677,
   "ko": "내 사용량을 씀",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 678,
   "ko": "내 세션을 바꿈",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 679,
   "ko": "내 세션을 봄",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 680,
   "ko": "내 컴퓨터에서 나처럼 행동",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 681,
   "ko": "내 플랜이나 API 키로 모델을 호출해요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 682,
   "ko": "네트워크 요청을 보내요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 683,
   "ko": "는 Claude가 사용자에게 묻는 대화상자를 다시 그릴 수 있다는 뜻이고,",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 684,
   "ko": "는 권한 확인창이 뜨기도 전에 도구 호출을 승인·거부할 수 있다는 뜻이에요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 685,
   "ko": "는 대화의 각 줄을 저장되기 전에 고쳐 쓸 수 있다는 뜻이에요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 686,
   "ko": "다른 세션이나 서브에이전트의 Claude가 읽는 메시지를 보내요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 687,
   "ko": "도구 호출을 승인하는 mod는",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 688,
   "ko": "라면, 내장 가드(",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 689,
   "ko": "라벨 읽는 법.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 690,
   "ko": "라이선스 게이트",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 691,
   "ko": "라이선스가 아예 없는 저장소의 코드예요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 692,
   "ko": "로 내 컴퓨터에서 프로그램을 실행해요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 693,
   "ko": "로 다른 세션에 메시지를 보내요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 694,
   "ko": "로 대화 내용에 닿아요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 695,
   "ko": "로 모델을 불러요. 내 사용량을 써요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 696,
   "ko": "로 소리를 내요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 697,
   "ko": "로 인터넷이나 외부 서버와 통신해요. 대화 내용이 나갈 수도 있으니 목적지를 확인하세요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 698,
   "ko": "로 직접 한 번 더 확인해 보세요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 699,
   "ko": "로 파일을 써요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 700,
   "ko": "로 프롬프트를 대신 넣거나 보내요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 701,
   "ko": "를 읽어요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 702,
   "ko": "를 통과하는지 확인하고, 사람이 코드 전체를 읽어요(",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 703,
   "ko": "마켓플레이스에서 바로 설치하기 전에, 그 mod가 받는 이벤트와 부르는 API를 실행 없이 볼 수 있어요. 저장소를 복제한 뒤 셸에서 실행하세요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 704,
   "ko": "묻지 않고 행동",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 705,
   "ko": "사용자에게 뭘 보여줄지는 조작할 수 없어요. (공식 문서:",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 706,
   "ko": "설치 전에 직접 확인하기",
   "ctx": "/guide/safety",
   "n": 2
  },
  {
   "i": 707,
   "ko": "업데이트 때 재검토",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 708,
   "ko": "에서 보는 상세 정보)에서 이런 걸 확인하세요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 709,
   "ko": "연결된 MCP 서버의 도구를 세션 권한 규칙 아래에서 불러요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 710,
   "ko": "위 어느 것도 안 하고 화면만 그려요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 711,
   "ko": "은 모든 도구 호출과 프롬프트를 보고 바꿀 수 있다는 뜻이고,",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 712,
   "ko": "을 켜 놨어도 mod는 영향받지 않아요. 샌드박스는 Claude가 실행하는 Bash 명령만 격리하고, mod가 직접 띄운 프로세스는 샌드박스 밖에서 돌아요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 713,
   "ko": "의심스러운 점이 있으면 설치 전에",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 714,
   "ko": "이 있는데, 설명 어디에도 왜 필요한지 안 적혀 있어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 715,
   "ko": "이런 mod는 조심하세요",
   "ctx": "/guide/safety",
   "n": 2
  },
  {
   "i": 716,
   "ko": "이에요. 👀가 있어도 🌐(네트워크)·⚙️(프로그램 실행)·💬(프롬프트 입력)이 없으면 그 mod는 대화를 기기 밖으로 내보낼 방법이 없어요. 💬는 Claude에게 대신 보내 달라고 시키는 우회로가 될 수 있어서 함께 봐요. 반대로 👀와 🌐가 함께 있으면 mod 페이지의 “코드에 있는 주소”와 검토 노트에서 어디로 무엇을 보내는지 꼭 확인하세요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 717,
   "ko": "작성자 요청 시 삭제",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 718,
   "ko": "정적 분석 + 코드 읽기",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 719,
   "ko": "종류(",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 720,
   "ko": "줄에 어떤 변수인지 나와요.",
   "ctx": "/guide/safety",
   "n": 2
  },
  {
   "i": 721,
   "ko": "줄에서 특히 눈여겨볼 항목이에요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 722,
   "ko": "줄에서는 이런 게 중요해요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 723,
   "ko": "처럼 도구 호출을 승인·거부할 수 있는 mod인데, 소스가 비공개거나 어떤 커밋을 받는지 알 수 없어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 724,
   "ko": "커밋 고정(",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 725,
   "ko": "토큰이나 비밀번호를 받으면서",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 726,
   "ko": "표시 없이 평문으로 저장해요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 727,
   "ko": "프롬프트를 대신 보내요. 내가 친 것처럼 보낼 수도 있어요",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 728,
   "ko": "한 mod에 라벨이 여러 개 붙을 수 있어요. 라벨이 없다면 화면만 바꾸는 mod라는 뜻이에요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 729,
   "ko": "화면을 그리는 mod는 거의 다 👀(대화 읽기)가 붙어요. 턴이 끝났다는 신호만 받아도 Claude의 마지막 답변이 함께 들어오기 때문이에요. 그래서 👀 하나만으로 걱정할 필요는 없어요. 정말 볼 것은",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 730,
   "ko": "환경변수·설정을 읽어요. API 키가 들어 있을 수 있어요. 출력의",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 731,
   "ko": "환경변수를 설정해요. 이후 Claude Code가 실행하는 모든 명령·MCP 서버에 영향을 줄 수 있어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 732,
   "ko": "회사 Claude Code 환경이라면 관리자가 mod 정책을 따로 둘 수 있어요.",
   "ctx": "/guide/safety",
   "n": 1
  },
  {
   "i": 733,
