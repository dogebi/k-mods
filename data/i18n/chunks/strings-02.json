   "ko": "선택 →",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 431,
   "ko": "설정값 넣기 (userConfig)",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 432,
   "ko": "설치 가이드 · Claude Code mods 가이드 · k-mods",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 433,
   "ko": "설치 범위(scope)",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 434,
   "ko": "설치·활성화 시점",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 435,
   "ko": "설치된 mod 확인하기",
   "ctx": "/guide/install",
   "n": 2
  },
  {
