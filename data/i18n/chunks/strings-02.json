   "n": 1
  },
  {
   "i": 443,
   "ko": "셸에서 값 넣기",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 444,
   "ko": "셸에서 설치·업데이트·삭제했거나",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 445,
   "ko": "셸에서 한 번만 실행하면 이 파일이 자동으로 만들어져요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 446,
   "ko": "셸에서는 더 자세히 볼 수 있어요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 447,
   "ko": "순으로 우선해요. 예를 들어 프로젝트가 켜 둔 mod를 나만 끄고 싶으면 local 범위에서 끄면 돼요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 448,
   "ko": "에 안 보여요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 449,
   "ko": "에 이렇게 적어서 커밋하세요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 450,
   "ko": "에 있어요.",
   "ctx": "/guide/install",
   "n": 3
  },
  {
   "i": 451,
   "ko": "에 적힌 mod는 “켜짐” 상태가 될 뿐, 팀원의 컴퓨터로 자동 다운로드되지는 않아요. 저장소를 새로 받은 각 팀원은 한 번씩 아래 명령을 실행해야 실제로 설치돼요 (워크스페이스를 신뢰(trust)한 뒤).",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 452,
   "ko": "워크스페이스를 아직 신뢰(trust)하지 않음",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 453,
   "ko": "으로 확인해요.",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 454,
   "ko": "은 바로 설치하지 않고, 먼저",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 455,
   "ko": "은 생략하면",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 456,
   "ko": "을 입력하면 탭 아래 흐린 글씨로",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 457,
   "ko": "의 “N mods active” 줄에 이름이 없음",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 458,
   "ko": "이 과정을 생략하면 Claude Code가 “",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 459,
   "ko": "이 아니라 운영체제의 안전한 저장소(macOS 키체인 등)에 저장돼요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 460,
   "ko": "이 저장소에서 나만",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 461,
   "ko": "이 저장소에서 작업하는 모두",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 462,
   "ko": "이 컴퓨터의 모든 프로젝트에서 나만",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 463,
   "ko": "이 플러그인을 켜 뒀지만 설치되어 있지 않다”고 알려줘요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 464,
   "ko": "일부 mod는 설치할 때 추가 값을 물어봐요 (API 주소, 토큰 등). 이 값들은 플러그인의",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 465,
   "ko": "저장소에 설정을 커밋해 두면, 그 저장소를 여는 모든 팀원에게 k-mods 마켓플레이스가 자동으로 등록되고 지정한 mod가 “켜짐” 상태로 시작돼요.",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 466,
   "ko": "조직 정책으로 막혀 있음",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 467,
   "ko": "주의할 점",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 468,
   "ko": "줄에 버전이 나와요.",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 469,
   "ko": "처럼 떠요. 이 줄에는",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 470,
   "ko": "최신 버전 유지하기",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 471,
   "ko": "탭 →",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 472,
   "ko": "탭에서 항목을 고르면",
   "ctx": "/guide/install",
   "n": 1
  },
  {
   "i": 473,
   "ko": "팀원과 함께 쓰기",
   "ctx": "/guide/install",
   "n": 2
  },
  {
   "i": 474,
   "ko": "패널 밖에서 설정 파일을 바꿨다면, 열려 있는 세션에는 자동으로 반영되지 않아요. 세션 안에서 이렇게 입력하세요.",
   "ctx": "/guide/install",
   "n": 1
  },
